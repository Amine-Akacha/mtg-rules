# ── Server ────────────────────────────────────────────────────────────────────
# Host port exposed by the container. Change if 8000 is already in use.
# HOST_PORT=8000

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Which LLM to use for answer generation. Must be "anthropic" or "openai".
LLM_PROVIDER=anthropic

# API keys — only the key for the active provider is required at runtime.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ── Model overrides (optional) ─────────────────────────────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OPENAI_MODEL=gpt-4o
# LLM_MAX_TOKENS=2048

# ── Paths (optional) ──────────────────────────────────────────────────────────
# CHROMA_DATA_PATH=./chroma_data
# RULES_PDF_PATH=./mtg-rules.pdf

# ── Retrieval tuning (optional) ────────────────────────────────────────────────
# TOP_K=5            # results per collection (rules + cards each)

# ── Ingest tuning (optional) ───────────────────────────────────────────────────
# RULE_CHUNK_MAX_WORDS=180  # soft word cap per rules chunk (embedding window)
# CHUNK_SIZE=500     # words per fixed-size fallback chunk
# CHUNK_OVERLAP=50   # word overlap between consecutive fallback chunks
# BATCH_SIZE=100     # ChromaDB upsert batch size
